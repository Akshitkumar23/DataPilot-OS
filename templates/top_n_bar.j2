import seaborn as sns
import matplotlib.pyplot as plt

{% if val_col %}
top = {{ df_var }}.groupby('{{ col }}')['{{ val_col }}'].sum().nlargest({{ n | default(10) }}).reset_index()
plt.figure(figsize=(11, 6), dpi=150)
sns.set_theme(style='whitegrid')
ax = sns.barplot(data=top, x='{{ val_col }}', y='{{ col }}', palette='Blues_r')
plt.title('Top {{ n | default(10) }} {{ col }} by {{ val_col }}', fontsize=14, fontweight='bold', pad=14)
for p in ax.patches:
    w = p.get_width()
    if w > 0:
        ax.annotate(f'{w:,.0f}', (w, p.get_y()+p.get_height()/2.), ha='left', va='center', xytext=(5,0), textcoords='offset points', fontsize=9, fontweight='bold')
plt.tight_layout()
plt.show()
print('[SUCCESS] Top {{ n | default(10) }} {{ col }} by {{ val_col }}!')
{% else %}
top = {{ df_var }}['{{ col }}'].value_counts().head({{ n | default(10) }}).reset_index()
top.columns = ['{{ col }}', 'Count']
plt.figure(figsize=(11, 6), dpi=150)
sns.set_theme(style='whitegrid')
ax = sns.barplot(data=top, x='Count', y='{{ col }}', palette='Blues_r')
plt.title('Top {{ n | default(10) }} {{ col }} by Count', fontsize=14, fontweight='bold', pad=14)
for p in ax.patches:
    w = p.get_width()
    if w > 0:
        ax.annotate(f'{int(w):,}', (w, p.get_y()+p.get_height()/2.), ha='left', va='center', xytext=(5,0), textcoords='offset points', fontsize=9, fontweight='bold')
plt.tight_layout()
plt.show()
print('[SUCCESS] Top {{ n | default(10) }} {{ col }} by count rendered!')
{% endif %}
