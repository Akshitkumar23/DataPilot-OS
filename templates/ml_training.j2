# 1. Generate Domain-Specific Engineered Features
if 'Gross_Sales' in engineered_df.columns and 'Quantity' in engineered_df.columns:
    engineered_df['Avg_Price_Per_Unit'] = (engineered_df['Gross_Sales'] / (engineered_df['Quantity'] + 1e-5)).round(2)
    print('  💡 Engineered: "Avg_Price_Per_Unit" = Gross_Sales / Quantity')

if 'Profit_Margin' in engineered_df.columns and 'Net_Sales' in engineered_df.columns:
    engineered_df['Profit_Ratio'] = (engineered_df['Profit_Margin'] / (engineered_df['Net_Sales'] + 1e-5)).round(4)
    print('  💡 Engineered: "Profit_Ratio" = Profit_Margin / Net_Sales')

if 'Discount_Amount' in engineered_df.columns and 'Gross_Sales' in engineered_df.columns:
    engineered_df['Discount_Rate'] = (engineered_df['Discount_Amount'] / (engineered_df['Gross_Sales'] + 1e-5)).round(4)
    print('  💡 Engineered: "Discount_Rate" = Discount_Amount / Gross_Sales')

if 'Total_Cost' in engineered_df.columns and 'Gross_Sales' in engineered_df.columns:
    engineered_df['Cost_To_Revenue_Ratio'] = (engineered_df['Total_Cost'] / (engineered_df['Gross_Sales'] + 1e-5)).round(4)
    print('  💡 Engineered: "Cost_To_Revenue_Ratio" = Total_Cost / Gross_Sales')

date_cols = engineered_df.select_dtypes(include=['datetime', 'datetime64']).columns
for dcol in date_cols:
    engineered_df[f'{dcol}_Month'] = engineered_df[dcol].dt.month
    engineered_df[f'{dcol}_DayOfWeek'] = engineered_df[dcol].dt.dayofweek
    print(f'  💡 Engineered Temporal Features from "{dcol}": Month, DayOfWeek')

# 2. Filter out High-Cardinality ID columns
low_card_cols = []
for col in engineered_df.columns:
    if col.lower().endswith('_id') or 'id' in col.lower() or col.lower().endswith('_name'):
        continue
    if engineered_df[col].nunique() > 50 and engineered_df[col].dtype == 'object':
        continue
    low_card_cols.append(col)

model_data = engineered_df[low_card_cols].dropna()

num_cols = model_data.select_dtypes(include='number').columns
target_col = '{{ target }}' if '{{ target }}' in num_cols else ('Profit_Margin' if 'Profit_Margin' in num_cols else (num_cols[-1] if len(num_cols) > 0 else model_data.columns[-1]))

X = pd.get_dummies(model_data.drop(columns=[target_col]), drop_first=True, dtype=int)
y = model_data[target_col]

