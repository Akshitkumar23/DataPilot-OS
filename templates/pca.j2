from sklearn.decomposition import PCA
from sklearn.preprocessing import StandardScaler
import seaborn as sns
import matplotlib.pyplot as plt

num_df = {{ df_var }}.select_dtypes(include='number').dropna()
X_scaled = StandardScaler().fit_transform(num_df)
pca = PCA(n_components={{ n_components | default(2) }})
coords = pca.fit_transform(X_scaled)
plt.figure(figsize=(9, 6), dpi=150)
plt.scatter(coords[:,0], coords[:,1], alpha=0.5, s=30, c='#0284c7')
plt.title(f'PCA 2D Projection (Variance explained: {sum(pca.explained_variance_ratio_)*100:.1f}%)', fontsize=13, fontweight='bold')
plt.xlabel('PC 1', fontweight='bold')
plt.ylabel('PC 2', fontweight='bold')
plt.tight_layout()
plt.show()
print(f'[SUCCESS] PCA rendered! Variance explained: {sum(pca.explained_variance_ratio_)*100:.1f}%')
