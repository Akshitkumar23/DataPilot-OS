import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import matplotlib.patches as mpatches
{% if not is_forecast %}
import matplotlib.ticker as ticker
{% endif %}

{% if is_forecast %}
{{ df_var }}['{{ dt_col }}'] = pd.to_datetime({{ df_var }}['{{ dt_col }}'], errors='coerce')
daily = {{ df_var }}.groupby({{ df_var }}['{{ dt_col }}'].dt.date)['{{ y_col }}'].sum().reset_index()
daily.columns = ['Date', '{{ y_col }}']
daily['Date'] = pd.to_datetime(daily['Date'])
daily = daily.sort_values('Date').reset_index(drop=True)

# 30-day rolling average baseline
daily['Rolling_30'] = daily['{{ y_col }}'].rolling(30, min_periods=5).mean()

# Simple linear trend forecast using numpy polyfit
x = np.arange(len(daily))
coeffs = np.polyfit(x, daily['{{ y_col }}'], 1)
slope, intercept = coeffs

# Generate {{ horizon }} future days forecast
last_date = daily['Date'].max()
future_dates = pd.date_range(start=last_date + pd.Timedelta(days=1), periods={{ horizon }}, freq='D')
future_x = np.arange(len(daily), len(daily) + {{ horizon }})
future_vals = slope * future_x + intercept
std_dev = daily['{{ y_col }}'].std()
upper_band = future_vals + 1.5 * std_dev
lower_band = future_vals - 1.5 * std_dev

# ── Plot ──
fig, ax = plt.subplots(figsize=(13, 6), dpi=150)
plt.style.use('seaborn-v0_8-whitegrid')

# Historical daily data
ax.plot(daily['Date'], daily['{{ y_col }}'], color='#94a3b8', linewidth=1, alpha=0.5, label='Daily Actual')

# 30-day rolling average
ax.plot(daily['Date'], daily['Rolling_30'], color='#10b981', linewidth=2.5, label='30-Day Rolling Avg')

# Forecast line
ax.plot(future_dates, future_vals, color='#f59e0b', linewidth=2.5, linestyle='--', label=f'{{ horizon }}-Day Forecast (Trend)')

# Confidence band
ax.fill_between(future_dates, lower_band, upper_band, alpha=0.18, color='#f59e0b', label='Forecast ±1.5σ Band')

# Divider line
ax.axvline(x=last_date, color='#ef4444', linestyle=':', linewidth=1.5, alpha=0.8)
ax.text(last_date, ax.get_ylim()[1] * 0.95, '  Forecast Start', color='#ef4444', fontsize=9, fontweight='bold')

ax.set_title('📈 {{ y_col }} — Historical Trend + {{ horizon }}-Day Forecast', fontsize=14, fontweight='bold', pad=14)
ax.set_xlabel('Date', fontsize=11, fontweight='bold')
ax.set_ylabel('{{ y_col }} (Daily Sum)', fontsize=11, fontweight='bold')
plt.xticks(rotation=30, ha='right', fontsize=9)
ax.legend(loc='upper left', fontsize=9)
plt.tight_layout()
plt.show()

print(f'[SUCCESS] {{ horizon }}-Day Time Series Forecast Generated!')
print(f'Last Actual Date: {last_date.date()}')
print(f'Forecast Period: {future_dates[0].date()} → {future_dates[-1].date()}')
print(f'Avg Forecast Value: {future_vals.mean():,.0f} per day')
print(f'Trend Slope: {slope:+.2f} per day ({"📈 Uptrend" if slope > 0 else "📉 Downtrend"})')
{% else %}
{{ df_var }}['{{ dt_col }}'] = pd.to_datetime({{ df_var }}['{{ dt_col }}'], errors='coerce')
monthly = {{ df_var }}.groupby({{ df_var }}['{{ dt_col }}'].dt.to_period('M'))['{{ y_col }}'].sum().reset_index()
monthly['{{ dt_col }}'] = monthly['{{ dt_col }}'].dt.to_timestamp()
fig, ax = plt.subplots(figsize=(12, 5), dpi=150)
ax.plot(monthly['{{ dt_col }}'], monthly['{{ y_col }}'], color='#10b981', linewidth=2.5, marker='o', markersize=5)
ax.fill_between(monthly['{{ dt_col }}'], monthly['{{ y_col }}'], alpha=0.12, color='#10b981')
ax.set_title('Monthly {{ y_col }} Trend', fontsize=14, fontweight='bold', pad=14)
ax.set_xlabel('Month', fontsize=11, fontweight='bold')
ax.set_ylabel('{{ y_col }}', fontsize=11, fontweight='bold')
ax.yaxis.set_major_formatter(ticker.FuncFormatter(lambda x, _: f'{x:,.0f}'))
plt.xticks(rotation=30, ha='right', fontsize=9)
plt.tight_layout()
plt.show()
print('[SUCCESS] Monthly {{ y_col }} trend chart rendered!')
{% endif %}
